{
  "name": "cimmeria-launcher-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "esbuild src/game-update-view.test.ts src/game-telemetry-view.test.ts src/updater-view.test.ts src/migration-view.test.ts src/adoption-view.test.ts src/launch-view.test.ts src/workflows.test.ts src/install-workflow.test.ts src/install-view.test.ts src/view.test.ts src/patch-notes.test.ts src/server-list-view.test.ts src/client-patches-view.test.ts src/log-upload-view.test.ts src/client-maintenance-view.test.ts src/client-changes-view.test.ts src/physx-view.test.ts src/seed-archive-view.test.ts src/contract.test.ts src/panel-context.test.ts src/transfer-rate.test.ts src/ui-event.test.ts src/telemetry-status-view.test.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --out-extension:.js=.mjs && node --test .test-build/*.test.mjs",
    "uat": "esbuild src/workflows.ts src/view.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --out-extension:.js=.mjs && node uat.mjs",
    "build": "tsc --noEmit && node build.mjs",
    "uat:install": "esbuild src/install-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/install-view.mjs && node install-uat.mjs",
    "uat:launch": "esbuild src/launch-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/launch-view.mjs && node launch-uat.mjs",
    "uat:migration": "esbuild src/migration-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/migration-view.mjs && node migration-native-uat.mjs",
    "uat:updater": "esbuild src/updater-view.ts src/composition.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --out-extension:.js=.mjs && node updater-native-uat.mjs",
    "uat:updater-apply": "esbuild src/updater-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/updater-view.mjs && node updater-apply-native-uat.mjs",
    "uat:game-update": "esbuild src/game-update-workflow.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/game-update-workflow.mjs && node game-update-native-uat.mjs",
    "uat:game-update-apply": "esbuild src/game-update-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/game-update-view.mjs && node game-update-apply-native-uat.mjs",
    "uat:game-telemetry": "esbuild src/game-telemetry-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/game-telemetry-view.mjs && node game-telemetry-native-uat.mjs",
    "uat:adoption": "esbuild src/adoption-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/adoption-view.mjs && node adoption-uat.mjs",
    "uat:server-list": "esbuild src/server-list-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/server-list-view.mjs && node server-list-uat.mjs",
    "uat:client-patches": "esbuild src/client-patches-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/client-patches-view.mjs && node client-patches-uat.mjs",
    "uat:log-upload": "esbuild src/log-upload-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/log-upload-view.mjs && node log-upload-uat.mjs",
    "uat:client-maintenance": "esbuild src/client-maintenance-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/client-maintenance-view.mjs && node client-maintenance-uat.mjs",
    "uat:about": "esbuild src/view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/view.mjs && node about-uat.mjs",
    "uat:client-changes": "esbuild src/client-changes-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/client-changes-view.mjs && node client-changes-uat.mjs",
    "uat:physx": "esbuild src/physx-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/physx-view.mjs && node physx-uat.mjs",
    "uat:seed-archive": "esbuild src/seed-archive-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/seed-archive-view.mjs && node seed-archive-uat.mjs"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.25.12",
    "linkedom": "0.18.12",
    "typescript": "5.7.3"
  }
}
