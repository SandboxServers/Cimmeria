{
  "name": "cimmeria-launcher-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "esbuild src/updater-view.test.ts src/migration-view.test.ts src/launch-view.test.ts src/workflows.test.ts src/install-workflow.test.ts src/install-view.test.ts src/view.test.ts src/patch-notes.test.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --out-extension:.js=.mjs && node --test .test-build/*.test.mjs",
    "uat": "esbuild src/workflows.ts src/view.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --out-extension:.js=.mjs && node uat.mjs",
    "build": "tsc --noEmit && node build.mjs",
    "uat:install": "esbuild src/install-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/install-view.mjs && node install-uat.mjs",
    "uat:launch": "esbuild src/launch-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/launch-view.mjs && node launch-uat.mjs",
    "uat:migration": "esbuild src/migration-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/migration-view.mjs && node migration-native-uat.mjs",
    "uat:updater": "esbuild src/updater-view.ts src/composition.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --out-extension:.js=.mjs && node updater-native-uat.mjs",
    "uat:updater-apply": "esbuild src/updater-view.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/updater-view.mjs && node updater-apply-native-uat.mjs"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.25.12",
    "linkedom": "0.18.12",
    "typescript": "5.7.3"
  }
}
