{
  "name": "cimmeria-launcher-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "esbuild src/workflows.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/workflows.test.mjs && node --test .test-build/workflows.test.mjs",
