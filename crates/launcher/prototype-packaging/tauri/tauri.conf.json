{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cimmeria Tauri Proof",
  "version": "0.1.0",
  "identifier": "app.cimmeria.packaging.tauri",
  "build": {"frontendDist": "ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title":"Stargate Worlds — Tauri proof","width":620,"height":700,"minWidth":480,"minHeight":560}],
