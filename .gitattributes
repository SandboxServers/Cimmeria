# Force consistent line endings for generated lock files to prevent
# cross-platform conflicts between Linux (LF) and Windows (CRLF) checkouts.
Cargo.lock text eol=lf
frontend/package-lock.json text eol=lf

# Container build artefacts must stay LF — Linux interprets the shebang
# byte-for-byte and `\r` in the interpreter line is a hard syntax error.
docker/** text eol=lf
.github/workflows/*.yml text eol=lf

# Paged collision-geometry occluders (NA27): compressed binary, never
# line-ending converted or diffed.
data/spaces/*.occ binary

# Shell scripts run under bash (Git Bash locally, Linux in CI); a CR at the end of a
# line breaks them, so they stay LF on every checkout.
*.sh text eol=lf
.github/actions/**/*.yml text eol=lf

# Append-only lists: PRs add rows and rarely edit one in place, so two PRs that both
# append conflict only because they touch the same end of the file. `union` keeps
# both sides' lines instead of conflicting. It applies to local merges and rebases
# only (GitHub's own conflict check ignores it), and if both sides edit the same
# line it keeps both versions, so check the result. Files whose lines are edited in
# place (gap-analysis, project-status, the test inventory tables, crates/README.md)
# are deliberately not listed; see docs/agents/development-workflow.md.
.claude/agent-memory/*/MEMORY.md merge=union
docs/reverse-engineering/findings/README.md merge=union
docs/readme.md merge=union

# Client UI overlay (BM-05): byte-for-byte copies of stock client files, patched.
# The client reads them as-is, so they keep their CRLF line endings on every
# checkout and are never converted.
crates/client-patches/overlay/Content/** -text
