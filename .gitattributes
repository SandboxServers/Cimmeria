# Force consistent line endings for generated lock files to prevent
# cross-platform conflicts between Linux (LF) and Windows (CRLF) checkouts.
Cargo.lock text eol=lf
frontend/package-lock.json text eol=lf

# Container build artefacts must stay LF — Linux interprets the shebang
# byte-for-byte and `\r` in the interpreter line is a hard syntax error.
docker/** text eol=lf
.github/workflows/*.yml text eol=lf

# Paged collision-geometry occluders (NA27): compressed binary, never
# line-ending converted or diffed.
data/spaces/*.occ binary

# Shell scripts run under bash (Git Bash locally, Linux in CI); a CR at the end of a
# line breaks them, so they stay LF on every checkout.
*.sh text eol=lf
.github/actions/**/*.yml text eol=lf
