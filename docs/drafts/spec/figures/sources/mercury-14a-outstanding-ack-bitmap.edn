(draw-box (text "1 ← seq 142 lives at bit 14 (142 & 0x1F)" :pivot) {:span 1 :borders {:all true}})
(draw-box (text "0" :clr) {:span 1 :borders {:all true}})

(draw-column-headers {:labels (mapv str (range 16 32))})

