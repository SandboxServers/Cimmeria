{
  "productName": "Cimmeria Scene Editor",
  "version": "0.1.0",
  "identifier": "com.cimmeria.scene-editor",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cimmeria Scene Editor",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
