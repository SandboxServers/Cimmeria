      "description": "One sample per cast: fired, interrupted, refused, held (holstered-weapon queue).",
      "fillSpans": false,
      "id": "casts-by-outcome",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "abilities_cast_total",
                  "spaceAggregation": "sum",
                  "temporality": "cumulative",
                  "timeAggregation": "increase"
                }
              ],
              "dataSource": "metrics",
              "disabled": false,
              "expression": "A",
              "filter": {
                "expression": "service.name = 'cimmeria-server'"
              },
              "functions": [],
              "groupBy": [
                {
                  "dataType": "string",
                  "fieldContext": "attribute",
                  "fieldDataType": "string",
                  "isColumn": false,
                  "isJSON": false,
                  "key": "outcome",
                  "name": "outcome",
                  "signal": "metrics",
                  "type": "tag"
                },
                {
                  "dataType": "string",
                  "fieldContext": "attribute",
                  "fieldDataType": "string",
                  "isColumn": false,
                  "isJSON": false,
                  "key": "caster",
                  "name": "caster",
                  "signal": "metrics",
                  "type": "tag"
                }
              ],
              "having": [],
              "legend": "{{outcome}} / {{caster}}",
              "orderBy": [],
              "queryName": "A",
              "selectColumns": [],
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [
          {
            "disabled": false,
            "legend": "",
