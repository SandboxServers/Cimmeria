# Cimmeria game stack settings. Copy to .env beside compose.yml and
# chmod 0600; compose reads it on its own. Never commit the real file.
# Every variable compose.yml and its overlays read is listed here.

# Overlays to apply on every `docker compose` call, colon-separated.
# Examples:
#   COMPOSE_FILE=compose.yml
#   COMPOSE_FILE=compose.yml:compose.discord-file.yml:compose.lab.yml   (the colo)
#   COMPOSE_FILE=compose.yml:compose.discord-file.yml:compose.lab.yml:compose.auth-proxy.yml   (the colo, with launcher sign-in)
COMPOSE_FILE=compose.yml

# Required. The address players' clients connect to (public IP or DNS name).
# 127.0.0.1 only works for a client on this host.
BASE_EXTERNAL=

# Where the server's log files go on the host. No rotation; use a roomy disk.
CIMMERIA_LOG_DIR=./logs

# Host address the admin API (8443, no authentication) is published on.
# Keep it on loopback or a private address.
ADMIN_PUBLISH=127.0.0.1

# OTLP collector. Unset = the SigNoz stack on signoz-net. Set it empty
# (OTEL_EXPORTER_OTLP_ENDPOINT=) to switch telemetry export off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Seconds to wait for the collector at container start before giving up.
# OTEL_WAIT_TIMEOUT=120
# deployment.environment on every SigNoz row.
# CIMMERIA_DEPLOY_ENV=colo
# RUST_LOG=info

# Developer mode (default false). Skips the client protocol-digest check.
# It never bypasses the password check while the server has a database.
# DEVELOPER_MODE=false

# Auth reverse-proxy listener, for a TLS-terminating reverse proxy only. Never publish it to the internet.
# AUTH_PROXY_ADDR=0.0.0.0:13480
# Only peers in AUTH_PROXY_TRUSTED_PEERS (default 127.0.0.0/8,::1, loopback only) may send X-Forwarded-*. Docker publishes this port through the bridge gateway, so list that gateway; until it is set the listener answers 403 https_required.
# AUTH_PROXY_TRUSTED_PEERS=127.0.0.1/32,::1,<bridge-gateway>/32

# Client telemetry from opted-in launchers (docs/operations/telemetry.md).
# Secret: openssl rand -hex 64. Upload endpoint: an https URL you serve,
# e.g. https://play.example.org/api/telemetry. Blank means none: the mint
# answers 503 unless a proxy sends Host, X-Forwarded-Proto: https and
# X-Forwarded-For (docs/operations/telemetry-upload-endpoint.md).
CIMMERIA_TELEMETRY_HMAC_SECRET=
CIMMERIA_TELEMETRY_UPLOAD_ENDPOINT=

# Sign-in providers (identity). Leave all of these blank for the defaults.
# Path to the providers file. Blank uses config/auth-providers.toml; with compose.auth.yml, keep it blank. Otherwise point it at a path inside an already-mounted config folder.
# CIMMERIA_AUTH_PROVIDERS=
# Client secret of the discord provider. Secrets go here, never in the providers file.
# CIMMERIA_IDP_DISCORD_SECRET=
# Client secret of the google provider, same pattern as the discord one.
# CIMMERIA_IDP_GOOGLE_SECRET=
# Client secret of the oidc provider. A provider with another client_secret_env
# name needs that name here and in docker/compose.yml (or a compose.override.yml).
# CIMMERIA_IDP_OIDC_SECRET=
# Set to 1 to run with no sign-in providers.
# CIMMERIA_IDP_DISABLED=
# Set to 1 to close new account creation through sign-in.
# CIMMERIA_IDP_SIGNUP_DISABLED=
# Set to 1 to report soap_relay=false on the providers route, so launchers skip the SOAP relay.
# CIMMERIA_SOAP_RELAY_DISABLED=

# Watchtower swap announcements (optional). A shoutrrr URL such as
# discord://<token>@<webhook-id>. Leave both blank for none.
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=

# compose.lab.yml only: this host's private (LAN/VPN) address and a 32+ byte
# token (openssl rand -hex 32).
# CIMMERIA_WG_IP=
# CIMMERIA_LAB_MCP_TOKEN=

# compose.auth-proxy.yml only (docs/operations/auth-https.md): an optional
# narrower trusted-peer list for the proxy listener (empty keeps
# 127.0.0.0/8,::1). The provider secrets are above.
# AUTH_PROXY_TRUSTED_PEERS=
# CIMMERIA_IDP_DISABLED=
# CIMMERIA_IDP_SIGNUP_DISABLED=
# CIMMERIA_SOAP_RELAY_DISABLED=

# --- Database persistence --------------------------------------------
# Host directory for pre-rebuild database backups (newest N kept).
# CIMMERIA_BACKUP_DIR=./backups
# How many backups to keep.
# CIMMERIA_DB_BACKUP_KEEP=10
# Set to 1 for one start to rebuild resources from the image seeds
# (resources only; player data kept). Unset it afterwards.
# CIMMERIA_DB_FORCE_REBUILD=
# Disaster recovery only; leave unset. File name under the backup dir
# to restore over the live database (a safety backup is taken first).
# CIMMERIA_DB_RESTORE=
