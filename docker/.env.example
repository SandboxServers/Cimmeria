# Cimmeria colo deployment — environment overrides for docker/compose.yml.
#
# Copy this file to `.env` in the same directory as compose.yml, fill in the
# real values, and lock it down. The .env file is gitignored — never commit it.
#
#   cp .env.example .env && chmod 600 .env
#
# Compose reads .env automatically from the directory you run
# `docker compose` in, and substitutes the ${VAR} references in compose.yml.

# Public IP / hostname the game client connects to. MUST be set to this host's
# reachable address for any client that isn't on the same machine. Falls back
# to 127.0.0.1 (same-host only) inside the image if left unset.
BASE_EXTERNAL=

# cimmeria-discord notifications are OFF by default (like the optional SigNoz
# stack — the server runs fine with neither configured). To turn them on, set
# both of the following:
#
#   1. DISCORD_ENABLED=true
#   2. DISCORD_WEBHOOK to a real webhook URL. Create one in Discord:
#      Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
#
# All notification channels funnel to this single webhook; give each channel
# its own ${VAR} in compose.yml if you want per-channel routing. If
# DISCORD_ENABLED is left false, DISCORD_WEBHOOK is ignored entirely.
DISCORD_ENABLED=false
DISCORD_WEBHOOK=

# OPTIONAL: watchtower image-swap pings, as a shoutrrr URL
# (e.g. discord://token@channel_id). Only used if you uncomment the
# WATCHTOWER_NOTIFICATION_* lines in compose.yml.
WATCHTOWER_DISCORD_URL=

# OPTIONAL: override the SigNoz OTLP collector endpoint. Defaults to the
# in-network otel-collector:4317 provided by compose.signoz.yml.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
