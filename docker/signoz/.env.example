# SigNoz stack settings. Copy to .env beside compose.yaml (chmod 0600);
# compose reads it on its own. Never commit the real file.

# Required. Signs SigNoz UI sessions. Generate with: openssl rand -hex 32
SIGNOZ_JWT_SECRET=

# Address the UI (8080) is published on. 127.0.0.1 = this host only (use an
# SSH tunnel). Set it to the host's LAN/VPN address for operators on that
# network. 0.0.0.0 publishes it on every interface, including any your
# network edge forwards from the internet.
SIGNOZ_UI_BIND=127.0.0.1

# Address the OTLP receivers (4317 gRPC, 4318 HTTP) are published on. The
# game container does not need this. Set it to the LAN/VPN address to accept
# telemetry from other machines on that network. The collector has no auth.
OTLP_BIND=127.0.0.1

# Image tag overrides (defaults are the versions this directory was vendored at).
# VERSION=v0.125.1
# OTELCOL_TAG=v0.144.4
