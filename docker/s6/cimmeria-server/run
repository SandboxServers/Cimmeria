#!/command/with-contenv sh
# Wait for postgres to accept connections before launching the server.
# Without this the server's startup DB pool fails on a tight race during
# the first ~1-2 seconds after `docker run`.
#
# Bounded wait: if postgres never comes up (corrupt pgdata, permission
# issue, etc.) we exit non-zero. The `finish` script will then tear the
# whole supervision tree down so the container exits and the
# orchestrator (Docker, compose, Kubernetes) can surface the failure
# and restart cleanly. Without a deadline this would block forever and
# leave a healthy-looking but useless container.
TIMEOUT_S="${POSTGRES_WAIT_TIMEOUT:-120}"
deadline=$(( $(date +%s) + TIMEOUT_S ))
while ! pg_isready -h 127.0.0.1 -U "${POSTGRES_USER:-w-testing}" -d "${POSTGRES_DB:-sgw}" >/dev/null 2>&1; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
        echo "[cimmeria-server] postgres did not become ready within ${TIMEOUT_S}s — exiting" >&2
        exit 1
    fi
    sleep 0.5
done

# Wait for the OTLP collector too, so a cold start (host reboot, Docker
# restart) doesn't open with a burst of export errors while SigNoz is still
# booting. Telemetry is optional: after OTEL_WAIT_TIMEOUT seconds start
# anyway. This lives here, not in /etc/cont-init.d, because s6-overlay v3
# starts this service in parallel with the legacy cont-init scripts.
if [ -n "${OTEL_EXPORTER_OTLP_ENDPOINT:-}" ]; then
    hp="${OTEL_EXPORTER_OTLP_ENDPOINT#*://}"; hp="${hp%%/*}"
    otel_host="${hp%:*}"; otel_port="${hp##*:}"
    [ "$otel_port" = "$hp" ] && otel_port=4317
    otel_deadline=$(( $(date +%s) + ${OTEL_WAIT_TIMEOUT:-120} ))
    until timeout 3 bash -c "exec 3<>/dev/tcp/${otel_host}/${otel_port}" 2>/dev/null; do
        if [ "$(date +%s)" -ge "$otel_deadline" ]; then
            echo "[cimmeria-server] OTLP collector ${otel_host}:${otel_port} not reachable after ${OTEL_WAIT_TIMEOUT:-120}s; starting without it" >&2
            break
        fi
        sleep 2
    done
fi

# The server resolves its data/* paths relative to CWD, so we must `cd`
# into /opt/cimmeria where data/cache/*.pak and data/spaces/*.nav live.
cd /opt/cimmeria
# Drop privileges. Postgres runs as the `postgres` system user; the
# server runs as the dedicated `cimmeria` user (UID/GID 1001) created
# in the runtime stage of the Dockerfile. There's no reason for an
# internet-facing process to keep root, even inside a container.
exec s6-setuidgid cimmeria /opt/cimmeria/bin/cimmeria-server
